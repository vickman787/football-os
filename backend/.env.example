# Football OS API config
PORT=5000

# RapidAPI · API-Football
# https://rapidapi.com/api-sports/api/api-football
# Leave blank to use mock data — the API will degrade gracefully.
FOOTBALL_API_KEY=
FOOTBALL_API_HOST=api-football-v1.p.rapidapi.com

# OpenRouter · LLM gateway
# https://openrouter.ai/keys
# Leave blank to use mock predictions.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
